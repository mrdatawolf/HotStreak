# Copy to .env and fill in. Read by the API (api/app/config.py) and the web dev server (web/vite.config.ts).

# Where the API listens. The web app's /api proxy points here too.
TRACKER_API_HOST=127.0.0.1
TRACKER_API_PORT=8000

# Web dev server address and port. 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network.
TRACKER_WEB_IP=127.0.0.1
TRACKER_WEB_PORT=5190
# Hostnames other machines may use to open the app (comma-separated). IP addresses always work.
# TRACKER_WEB_ALLOWED_HOSTS=office-pc,office-pc.local

# Break-glass super admin, for first-time setup and for recovering if every admin is locked out.
# Sign in with this username and password. It always has full access and can't be locked or disabled.
# Use a long random password (e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`).
# Leave the password empty to turn break-glass off.
TRACKER_BREAKGLASS_USER=breakglass
TRACKER_BREAKGLASS_PASSWORD=

# The client's Google Sheet, synced into the app. Sync is off until both are set; see Admin → Sheet.
# TRACKER_GOOGLE_SHEET=https://docs.google.com/spreadsheets/d/<id>
# Service-account JSON key that the sheet is shared with (Viewer). Relative paths are from this folder.
# TRACKER_GOOGLE_CREDENTIALS=api/secrets/google-service-account.json
# Minutes between syncs; 0 = only when an admin clicks "Sync now".
# TRACKER_GOOGLE_SYNC_MINUTES=5

# Optional overrides:
# TRACKER_DATABASE_URL=sqlite:////absolute/path/to/tracker.db
# TRACKER_CORS_ORIGINS=http://localhost:5190
# TRACKER_SESSION_DAYS=14
